{
  "name": "@moj/content",
  "version": "0.1.0",
  "description": "Markdown pipeline, sanitiser presets and markdown-to-Typst for MOJ",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "styles",
    "typst",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/content.css": "./styles/content.css",
    "./typst/statement.typ": "./typst/statement.typ",
    "./typst/booklet.typ": "./typst/booklet.typ",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor:typst": "node scripts/vendor-typst-packages.mjs"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.1",
    "hast-util-sanitize": "^5.0.2",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark-util-types": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
