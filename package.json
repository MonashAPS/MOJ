{
  "name": "moj",
  "private": true,
  "version": "1.25.0",
  "description": "MOJ, the MAPS Online Judge",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "convex",
    "apps/*",
    "packages/*",
    "tools/*",
    "docs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node infra/scripts/setup.mjs",
    "dev": "concurrently -k -n convex,web -c blue,green \"npm:dev:convex\" \"npm:dev:web\"",
    "dev:convex": "convex dev",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "e2e:judge": "node infra/scripts/e2e-judge.mjs",
    "test:watch": "vitest",
    "lint": "biome check . && oxlint",
    "format": "biome format --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "convex:codegen": "convex codegen",
    "convex:deploy": "convex deploy",
    "seed": "convex run seed:run '{}'",
    "prepare": "npm run build --workspace packages/content && lefthook install",
    "knip": "knip",
    "lint:fix": "biome check --write . && oxlint --fix"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.1",
    "concurrently": "^10.0.5",
    "convex": "^1.45.0",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "oxlint": "1.83.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
