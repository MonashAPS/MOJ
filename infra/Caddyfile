# Production reverse proxy for MOJ.
#
# Three public surfaces, plus the problems API published on the first one:
#   judge.example.com            the Next.js app
#   convex.judge.example.com     the Convex client API (websockets)
#   convex-site.judge.example.com the Convex HTTP actions (judge API, health)
#
# Set MOJ_DOMAIN before starting Caddy, or edit the names in place.

{
	email {$CADDY_EMAIL:admin@example.com}
}

{$MOJ_DOMAIN:judge.example.com} {
	encode zstd gzip

	# Long-lived immutable assets from Next.js, and the imported DMOJ media
	# tree the app serves at /media/... (content addressed upload names).
	@static path /_next/static/* /fonts/* /media/* /favicon.ico /icon.svg
	header @static Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The problems API is a Convex HTTP action, but a problem repository should
	# only ever need one address for the judge, so it is published on the site's
	# own origin. The web app has the same rewrite (apps/web/src/proxy.ts);
	# routing it here keeps the upload off the Next.js server entirely.
	handle /api/problems/* {
		reverse_proxy convex-backend:3211
	}

	handle {
		reverse_proxy web:3000
	}
}

convex.{$MOJ_DOMAIN:judge.example.com} {
	encode zstd gzip
	reverse_proxy convex-backend:3210
}

convex-site.{$MOJ_DOMAIN:judge.example.com} {
	encode zstd gzip
	reverse_proxy convex-backend:3211
}

dashboard.{$MOJ_DOMAIN:judge.example.com} {
	encode zstd gzip
	reverse_proxy convex-dashboard:6791
}
