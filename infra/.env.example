# MOJ environment. `npm run setup` writes a working .env.local at the repo root
# from these defaults; copy this file only if you want to override something.
# Never commit .env or .env.local.

# --- Convex (self-hosted backend in Docker) ---------------------------------
# Admin connection used by the Convex CLI (push, codegen, run, import).
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=

# What the browser and the Next.js server talk to.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# HTTP actions (convex/http.ts): /health, and later the judge API.
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Compose knobs for the backend container.
INSTANCE_NAME=moj-dev
INSTANCE_SECRET=4d4f4a2d646576656c6f706d656e742d696e7374616e63652d7365637265740a
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
CONVEX_IMAGE_TAG=latest

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=moj
POSTGRES_PASSWORD=moj
POSTGRES_PORT=5433
# Convex's backing database. The backend derives this name from INSTANCE_NAME
# (dashes become underscores), so leave it alone unless you change INSTANCE_NAME.
CONVEX_DATABASE=moj_dev
AUTH_DATABASE=moj_auth

# Better Auth's own database, used by Drizzle.
DATABASE_URL=postgresql://moj:moj@127.0.0.1:5433/moj_auth

# --- Better Auth ------------------------------------------------------------
# 32+ random bytes. `openssl rand -base64 32`.
AUTH_SECRET=
# Issuer of the JWTs Convex trusts. In dev this is the Next.js origin.
AUTH_ISSUER=http://localhost:3000
# Where the Convex backend fetches the JWKS. The backend runs in Docker, so it
# reaches the Next.js dev server through the host gateway, not localhost.
AUTH_JWKS_URL=http://host.docker.internal:3000/api/auth/jwks
# Relying party id for passkeys. Bare hostname, no scheme or port.
AUTH_RP_ID=localhost
# Public origin of the web app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where the Convex problems API verifies API keys against Better Auth's
# api-key plugin. This is set on the Convex deployment, and Convex runs in
# Docker, so it reaches the Next.js server through the host gateway. Leave it
# unset if the container cannot reach the host: the API then falls back to the
# `apiKeys` table, which `npm run setup` handles for you.
AUTH_URL=http://host.docker.internal:3000
# DMOJ's `SECRET_KEY` from the site being imported. API v2 tokens minted by the
# old site are `hmac_sha256(LEGACY_SECRET_KEY, secret)`, so legacy tokens only
# keep working when this matches. Take it from tools/import/secrets.env.
LEGACY_SECRET_KEY=

# --- Development only -------------------------------------------------------
# The superuser `npm run setup` creates is staff, and staff must hold a second
# factor, so it is enrolled in TOTP against this fixed secret. Fixed on purpose:
# the codes are then reproducible and a test can generate one. Never set this on
# a deployment; without it, no enrolment happens.
MOJ_DEV_TOTP_SECRET=mojdevtotpsecretdonotuseinprod01
# The development superuser setup creates, printed again when it finishes. The
# password default is deliberately not `admin`: that one is in the Have I Been
# Pwned corpus, and the site's own breached-password check would send the
# documented login straight to the forced-change interstitial.
MOJ_ADMIN_USERNAME=admin
MOJ_ADMIN_PASSWORD=moj-admin-local
MOJ_ADMIN_EMAIL=admin@example.com
# Optional taskset-style CPU list for the heavy child processes `npm run setup`
# spawns, for a machine that has to keep some cores free. Unset, nothing is
# pinned.
MOJ_CPUSET=

# --- Accounts ---------------------------------------------------------------
# DMOJ's BAD_MAIL_PROVIDERS and BAD_MAIL_PROVIDER_REGEX: extra disposable-email
# domains and patterns to refuse at sign-up, on top of the built-in list.
BAD_MAIL_PROVIDERS=
BAD_MAIL_PROVIDER_REGEX=
# Set to `off` to skip the Have I Been Pwned k-anonymity check on sign-up,
# password change and password reset. On by default.
HIBP_CHECK=

# --- Mail -------------------------------------------------------------------
# Every message the site sends -- activation, password reset, email change and
# the two-factor notices -- goes out through one transport, chosen here.
#
#   console  the message is written to the server console. The default, and the
#            only mode that needs no credentials.
#   ses      Amazon SES, through @aws-sdk/client-ses and the SES_* variables.
#   smtp     any SMTP server, through nodemailer and the SMTP_* variables.
MAIL_MODE=console
# The envelope sender. On SES this address (or its domain) has to be verified.
MAIL_FROM=noreply@example.com

# MAIL_MODE=ses. The region is required. Leave the key and secret unset to use
# the SDK's own credential chain instead, which is how an instance role or a
# mounted profile is meant to be picked up; set both or neither.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# MAIL_MODE=smtp. The host is required. The port defaults to 587, and 465
# implies implicit TLS; anything else starts in the clear and upgrades with
# STARTTLS. SMTP_SECURE overrides that guess. Set the user and the password
# together, or leave both unset for a relay that does not authenticate.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# --- Judge ------------------------------------------------------------------
JUDGE_NAME=local
JUDGE_KEY=localjudgekey
# Where the judge container pulls work from: the Convex site origin, which is
# where the judge API's HTTP actions are served.
MOJ_JUDGE_URL=http://host.docker.internal:3211
# Optional taskset-style CPU list to pin the judge container to, for a machine
# that has to keep some cores free. It is only read through
# infra/compose.override.local.yml; copy the example beside it to use it.
JUDGE_CPUSET=

# --- Statement PDFs ---------------------------------------------------------
# Path to the typst binary that renders problem PDFs. The web image ships one at
# /usr/local/bin/typst.
TYPST_BIN=typst
# Where statement.typ, booklet.typ and the vendored @preview packages live.
# Unset, they are found beside the installed @moj/content; the web image copies
# them to /opt/moj/typst instead.
TYPST_TEMPLATE_DIR=
# Extra font directories for typst, colon separated. The web image points this
# at /usr/share/fonts.
TYPST_FONT_PATHS=

# --- Media ------------------------------------------------------------------
# The imported DMOJ upload tree the app serves at /media/... .
MOJ_MEDIA_ROOT=infra/media

# --- Deployment (compose.prod.yml) ------------------------------------------
# The public hostname everything hangs off: the site is MOJ_DOMAIN, the Convex
# client API is convex.MOJ_DOMAIN and its HTTP actions convex-site.MOJ_DOMAIN.
# The web image reads these origins from its environment at run time, so
# changing the domain is a restart, not a rebuild.
MOJ_DOMAIN=judge.example.org
# Contact address Caddy registers the TLS certificates with.
CADDY_EMAIL=admin@example.org
# Which published release the stack runs: `latest`, or a version such as 1.4.3.
# `docker compose ... build` tags the local build with the same name.
MOJ_IMAGE_TAG=latest
# The runtimes tier the bundled judge image is built on, and the suffix on its
# published tag: tier1, tier2 or tier3.
JUDGE_TIER=tier1
