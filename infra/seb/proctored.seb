<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A starting point for a MOJ contest locked to Safe Exam Browser.

  Open it in the SEB Configuration Tool, change startURL, set a quit password,
  save, and read the Config Key off the Exam pane. Paste that key into the
  contest's Safe Exam Browser tab in the staff console. Saving from the tool
  also fills in every setting left out here.

  This configuration is deliberately permissive. It does not stop anyone
  switching to another application, does not filter what they browse to, and
  does not kill processes. What it does is prove, to the judge, that the person
  is running this exact configuration, and give SEB Server something to capture
  the screen of. Locking the machine down further is a different configuration
  and a different decision.
-->
<plist version="1.0">
<dict>
	<!-- 0 = starting an exam. 1 would reconfigure the client instead, which is
	     not what a competitor should be handed. -->
	<key>sebConfigPurpose</key>
	<integer>0</integer>

	<key>startURL</key>
	<string>https://judge.example.org/contest/mcpc/</string>

	<!-- The whole point. Without this SEB sends no hash and the judge has no
	     way to tell it apart from any other browser. -->
	<key>sendBrowserExamKey</key>
	<true/>
	<!-- The hash covers the requested URL, which is what MOJ recomputes
	     against. Turning this off makes every check fail. -->
	<key>browserURLSalt</key>
	<true/>

	<!-- Permissive by intent: see the note above. -->
	<key>allowSwitchToApplications</key>
	<true/>
	<key>monitorProcesses</key>
	<false/>
	<key>URLFilterEnable</key>
	<false/>
	<key>createNewDesktop</key>
	<false/>
	<key>killExplorerShell</key>
	<false/>
	<key>allowUserSwitching</key>
	<true/>
	<key>allowWlan</key>
	<true/>

	<!-- Quitting needs the password set in the Configuration Tool, so leaving
	     the contest is a deliberate act that SEB Server records. -->
	<key>allowQuit</key>
	<true/>

	<!-- Reconfiguring SEB from inside the session would change the Config Key
	     and is the one thing that has to stay shut. -->
	<key>allowPreferencesWindow</key>
	<false/>

	<!-- A judge shows verdicts as they arrive, so reloading has to work. -->
	<key>browserWindowAllowReload</key>
	<true/>

	<!-- SEB Server fills these in when it distributes the configuration. Left
	     empty, SEB runs standalone and captures nothing. -->
	<key>sebServerURL</key>
	<string></string>
	<key>sebServerFallback</key>
	<true/>
</dict>
</plist>
