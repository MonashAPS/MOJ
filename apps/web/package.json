{
  "name": "@moj/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:generate": "better-auth generate --config src/auth/server.ts --output src/auth/schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.3",
    "@better-auth/passkey": "1.7.3",
    "@moj/content": "*",
    "@moj/core": "*",
    "@moj/ui": "*",
    "better-auth": "1.7.3",
    "convex": "^1.45.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "katex": "^0.16.25",
    "lucide-react": "^1.44.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
